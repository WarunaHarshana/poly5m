# ---- Mode ----
# paper       = offline random-walk data + simulated fills (no network/money)
# paper_live  = REAL BTC prices + REAL Polymarket quotes, simulated fills
#               (no wallet or private key required, nothing at risk)
# live        = real data + REAL orders (funded wallet required)
MODE=paper_live
# Strategy: mid | late_scalp | hybrid (mid first, then late on same slot)
STRATEGY=mid
# CLOB ~5 share minimum for limit orders; stake auto-bumped when needed
# MIN_ORDER_SHARES=5
# ENFORCE_MIN_SHARES=1
# LATE_SCALP_MIN_REMAINING=8
# LATE_SCALP_MAX_REMAINING=35
# LATE_SCALP_MIN_ENTRY=0.88
# LATE_SCALP_MAX_ENTRY=0.97

# ---- Wallet / secrets (ONLY needed for MODE=live) ----
# NEVER commit this file. Never print your private key.
PRIVATE_KEY=
FUNDER_ADDRESS=
SIGNATURE_TYPE=3            # 0=EOA, 1=POLY_PROXY, 2=Safe, 3=deposit wallet (common on site)
# Optional CLOB API creds (if create/derive fails, paste from a working client)
# POLY_API_KEY=
# POLY_API_SECRET=
# POLY_API_PASSPHRASE=

# Real-money kill-switch: live mode refuses to start unless this is yes.
# Only set after successful paper_live runs. There is NO profit guarantee.
LIVE_CONFIRM=no
# LIVE_AGGRESSIVE=1  # do NOT set this unless you accept looser risk

# ---- Endpoints / chain ----
CLOB_HOST=https://clob.polymarket.com
GAMMA_HOST=https://gamma-api.polymarket.com
CHAIN_ID=137               # Polygon mainnet

# ---- Target market ----
# No token IDs needed: the bot auto-discovers the current BTC 5-minute
# up/down market (and its UP/DOWN token IDs) fresh before every round.

# ---- BTC price sources ----
# Polymarket 5m BTC markets resolve on Chainlink — keep chainlink first.
BTC_PRICE_SOURCES=chainlink,pyth,coinbase,binance,kraken

# ---- Strategy (conservative; live mode tightens further) ----
ROUND_SECONDS=300
MOMENTUM_LOOKBACK=12
SAMPLE_SECONDS=5
EDGE_THRESHOLD=0.05
MIN_EV=0.04
FEE_BUFFER=0.015            # subtract fees/adverse selection from edge
VOL_BLEND=0.5
MAX_SPREAD=0.06
MIN_ENTRY_PRICE=0.22        # do not buy lottery tickets
MAX_ENTRY_PRICE=0.60        # do not buy expensive favorites
MIN_CONFIDENCE=0.45
MIN_MOVE_USD=5              # need a clear $ move vs strike
MIN_ASK_SIZE=0              # live profile forces ~10
MIN_SLOT_SECONDS=90         # skip last 90s
MAX_TRADE_REMAINING=240     # skip first ~60s of each slot

# ---- Risk (minimal capital at risk) ----
STARTING_BANKROLL=50
BASE_TRADE_USD=1
MAX_TRADE_USD=1
MAX_EXPOSURE_USD=1
FIXED_STAKE_USD=1           # flat $1 when edge qualifies (no Kelly scale-up)
DAILY_LOSS_LIMIT_USD=5      # hard stop
DAILY_LOSS_LIMIT_PCT=0.05   # also stop at 5% of bankroll (tighter of the two)
MAX_TRADES_PER_DAY=10
MAX_CONSECUTIVE_LOSSES=3
KELLY_FRACTION=0.10
