# ==============================================================================
# Polymarket 5-Minute BTC TWAP Mispricing Bot (H-001) Configuration
# ==============================================================================

# --- Operating Mode ---
# paper_live = Real-time WebSockets (Chainlink RTDS + CLOB book) + simulated fills
# live       = Real-time WebSockets + real orders (requires funded Polygon wallet)
MODE=paper_live
LIVE_CONFIRM=no

# --- Strategy Target ---
ASSET=btc
TIMEFRAME=5m
SLOT_SECONDS=300

# --- H-004 Passive Maker Limit Model Thresholds ---
STRATEGY=H-005_MOMENTUM
MIN_Z_SCORE=1.15
ALPHA=1.75
MIN_SIGMA_USD=2.0
MAX_CHOP_CROSSES=2
MIN_MAKER_EDGE=0.05
MIN_MAKER_BID=0.55
MAX_MAKER_BID=0.90
EVAL_WINDOW_START_S=270
EVAL_WINDOW_END_S=15
TAKER_FEE_RATE=0.07
MAKER_REBATE_SHARE=0.20

# --- H-005 / LATE_MOMENTUM (Novals-style) ---
MOMENTUM_WINDOW_START_S=150
MOMENTUM_WINDOW_END_S=60
MOMENTUM_MIN_MOVE_USD=70
MOMENTUM_MAX_MOVE_USD=300
MOMENTUM_MIN_ASK=0.70
MOMENTUM_MAX_ASK=0.99
MOMENTUM_MIN_EDGE=0.00
MOMENTUM_EXIT_BEFORE_S=20
MOMENTUM_STOP_LOSS_ENABLED=no
MOMENTUM_STOP_LOSS_PCT=0.25
MOMENTUM_HEDGE_ENABLED=yes
MOMENTUM_HEDGE_TRIGGER_ASK=0.95
MOMENTUM_HEDGE_TRIGGER_SECONDS_LEFT=45
MOMENTUM_HEDGE_SHARE_PCT=3
MOMENTUM_HEDGE_NOTIONAL_MIN=1
MOMENTUM_HEDGE_NOTIONAL_MAX=2

# --- H-001 Sniper knobs ---
MIN_EDGE=0.035
MIN_BUY_PRICE=0.20
MAX_BUY_PRICE=0.92

# --- Risk & Sizing ---
STARTING_BANKROLL=50.0
BASE_STAKE_USD=5.0
MAX_STAKE_USD=10.0
DAILY_LOSS_LIMIT_USD=15.0
MAX_CONSECUTIVE_LOSSES=4
MIN_ORDER_SHARES=5.0

# --- Polymarket Authentication (Required only for MODE=live) ---
PRIVATE_KEY=
FUNDER_ADDRESS=
SIGNATURE_TYPE=3
CHAIN_ID=137

# --- WebSocket & API Endpoints ---
CHAINLINK_RTDS_URL=wss://ws-live-data.polymarket.com
CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
GAMMA_HOST=https://gamma-api.polymarket.com
CLOB_HOST=https://clob.polymarket.com
